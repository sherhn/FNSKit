# Скопируйте этот файл в .env. Секреты в разделе «Аккаунты» — пароли баз,
# первого администратора Keycloak и ключ шифрования документов — нужно задать
# самим. Остальное — пределы и настройки, их можно оставить как есть.

# --- Аккаунты (Keycloak) ---
# Публичный адрес сайта без слеша в конце. От него Keycloak строит ссылки и
# издателя токенов, а realm — адреса возврата после входа. Менять после
# первого запуска мало: realm импортируется один раз (backend/README.md).
FNSKIT_SITE_URL=http://localhost:8082
# Обязательны, без них стек не запустится. Сгенерировать: openssl rand -base64 32
# Postgres один на Keycloak и кабинет (сервис db): суперпользователь и две роли
# с разными паролями. Роли создаются при первом старте пустого тома, потом
# пароли из .env уже не меняют их в базе.
DB_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# База кабинета с загруженными документами и ключ их шифрования (AES-256-GCM).
# Ключ — base64 от 32 байт: openssl rand -base64 32. Храните его отдельно от
# базы и её копий: без ключа файлы не расшифровать, с ключом и копией базы —
# расшифровать всё.
CABINET_DB_PASSWORD=
CABINET_ENCRYPTION_KEY=
# Секрет служебного клиента Keycloak, которым кабинет сверяет владельцев файлов
# с аккаунтами: у удалённого аккаунта удаляются все файлы, ссылки и адрес для
# напоминаний. Попадает в realm при первом импорте. openssl rand -hex 32
CABINET_KEYCLOAK_SYNC_SECRET=
# Хранилище файлов кабинета (S3). В базе — только записи о файлах, сами файлы
# (зашифрованные) — в бакете. Локально это RustFS из docker-compose, ключи
# задаёте сами: openssl rand -hex 16 для ключа доступа и -base64 32 для
# секрета. В продакшене — адрес и ключи настоящего S3, бакет создаётся заранее,
# CABINET_S3_CREATE_BUCKET=false.
CABINET_S3_ACCESS_KEY=
CABINET_S3_SECRET_KEY=
# CABINET_S3_ENDPOINT_URL=http://s3:9000
# CABINET_S3_REGION=us-east-1
# CABINET_S3_BUCKET=fnskit-documents
# CABINET_S3_PATH_STYLE=true
# CABINET_S3_CREATE_BUCKET=true
# Почта для подтверждения адреса и сброса пароля. Локально письма ловит
# Mailpit (http://localhost:8025) и значения ниже можно не трогать; в
# продакшене — настоящий SMTP-сервер. docker-compose.prod.yml требует
# FNSKIT_SMTP_HOST, по умолчанию там порт 587 со STARTTLS и входом по паролю;
# неявный TLS на порту 465 не поддерживается.
FNSKIT_SMTP_HOST=mailpit
FNSKIT_SMTP_PORT=1025
FNSKIT_SMTP_FROM=noreply@fnskit.sherhn.space
FNSKIT_SMTP_STARTTLS=false
FNSKIT_SMTP_AUTH=false
FNSKIT_SMTP_USER=
FNSKIT_SMTP_PASSWORD=
# Тег образов в ghcr для docker-compose.prod.yml (по умолчанию latest). Чтобы
# откатиться, укажите тег нужного коммита.
# IMAGE_TAG=latest

# --- Ограничение частоты запросов ---
# Формат лимита: "10/minute" или несколько через ";": "10/minute;100/hour"
RATE_LIMIT_ENABLED=true
# true, если сервис стоит за доверенным прокси и IP берётся из X-Forwarded-For;
# false, если доступен напрямую
TRUST_PROXY_HEADERS=true
# Создание файлов (POST /v1/tiff). Ручка анонимная, лимит на один IP
RATE_LIMIT_TIFF=10/minute;100/hour

# --- Обработка файлов ---
# Максимальный размер загрузки за запрос (байты); nginx держит его чуть выше
MAX_TOTAL_BYTES=104857600
# Максимум итоговых страниц в одном запросе
MAX_PAGES=200
UPLOAD_CHUNK_BYTES=1048576
# Максимум мегапикселей на одну страницу после отрисовки
MAX_PAGE_MEGAPIXELS=50
# Максимум мегабайт на все страницы запроса вместе
MAX_RENDERED_MEGABYTES=300
# Общий потолок принятых загрузок по всем запросам сразу (МБ)
MAX_STAGED_MEGABYTES=400
# Одновременных обработок
MAX_CONCURRENT_JOBS=1
# Сколько ждать очереди обработки до ответа 503 (секунды)
PROCESSING_QUEUE_TIMEOUT_SECONDS=120
# Жёсткий предел длительности одной обработки (секунды)
PROCESSING_TIMEOUT_SECONDS=300
# Возраст, после которого рабочие папки удаляются (минуты), и частота уборки
TEMP_MAX_AGE_MINUTES=60
TEMP_SWEEP_INTERVAL_MINUTES=15

# Разрешённые origin для CORS. Нужно только локальной разработке, когда
# статику отдаёт IDE или отдельный сервер.
CORS_ORIGINS=http://localhost:63342,http://127.0.0.1:63342,http://localhost:8082,null
