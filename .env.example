# Скопируйте этот файл в .env. Секретов в стеке нет: все значения ниже — пределы
# и настройки обработки, их можно оставить как есть.

# --- Ограничение частоты запросов ---
# Формат лимита: "10/minute" или несколько через ";": "10/minute;100/hour"
RATE_LIMIT_ENABLED=true
# true, если сервис стоит за доверенным прокси и IP берётся из X-Forwarded-For;
# false, если доступен напрямую
TRUST_PROXY_HEADERS=true
# Создание файлов (POST /v1/tiff). Ручка анонимная, лимит на один IP
RATE_LIMIT_TIFF=10/minute;100/hour

# --- Обработка файлов ---
# Максимальный размер загрузки за запрос (байты); nginx держит его чуть выше
MAX_TOTAL_BYTES=104857600
# Максимум итоговых страниц в одном запросе
MAX_PAGES=200
UPLOAD_CHUNK_BYTES=1048576
# Максимум мегапикселей на одну страницу после отрисовки
MAX_PAGE_MEGAPIXELS=50
# Максимум мегабайт на все страницы запроса вместе
MAX_RENDERED_MEGABYTES=300
# Общий потолок принятых загрузок по всем запросам сразу (МБ)
MAX_STAGED_MEGABYTES=400
# Одновременных обработок
MAX_CONCURRENT_JOBS=1
# Сколько ждать очереди обработки до ответа 503 (секунды)
PROCESSING_QUEUE_TIMEOUT_SECONDS=120
# Жёсткий предел длительности одной обработки (секунды)
PROCESSING_TIMEOUT_SECONDS=300
# Возраст, после которого рабочие папки удаляются (минуты), и частота уборки
TEMP_MAX_AGE_MINUTES=60
TEMP_SWEEP_INTERVAL_MINUTES=15

# Разрешённые origin для CORS. Нужно только локальной разработке, когда
# статику отдаёт IDE или отдельный сервер.
CORS_ORIGINS=http://localhost:63342,http://127.0.0.1:63342,http://localhost:8082,null
