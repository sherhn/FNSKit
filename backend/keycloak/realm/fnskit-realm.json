{
  "realm": "fnskit",
  "enabled": true,
  "displayName": "ФНСКит",
  "displayNameHtml": "ФНСКит",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "rememberMe": false,
  "passwordPolicy": "length(8) and maxLength(128) and notUsername and notEmail",
  "bruteForceProtected": true,
  "bruteForceStrategy": "MULTIPLE",
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": [
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName",
    "totpAppFreeOTPName"
  ],
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru"
  ],
  "defaultLocale": "ru",
  "loginTheme": "fnskit",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": false,
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "no-referrer",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "strictTransportSecurity": "max-age=31536000"
  },
  "smtpServer": {
    "host": "${FNSKIT_SMTP_HOST}",
    "port": "${FNSKIT_SMTP_PORT}",
    "from": "${FNSKIT_SMTP_FROM}",
    "fromDisplayName": "ФНСКит",
    "starttls": "${FNSKIT_SMTP_STARTTLS}",
    "ssl": "false",
    "auth": "${FNSKIT_SMTP_AUTH}",
    "user": "${FNSKIT_SMTP_USER}",
    "password": "${FNSKIT_SMTP_PASSWORD}"
  },
  "clients": [
    {
      "clientId": "fnskit-web",
      "name": "ФНСКит",
      "description": "Сайт и кабинет: вход из браузера по коду авторизации с PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "consentRequired": false,
      "rootUrl": "${FNSKIT_SITE_URL}",
      "baseUrl": "/account",
      "redirectUris": [
        "${FNSKIT_SITE_URL}/account",
        "${FNSKIT_SITE_URL}/silent-check-sso"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FNSKIT_SITE_URL}/account",
        "oauth2.device.authorization.grant.enabled": "false",
        "use.refresh.tokens": "true"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-fnskit-cabinet",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "fnskit-cabinet",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "business_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "business_type",
            "claim.name": "business_type",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "company_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "company_name",
            "claim.name": "company_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"business_type\", \"displayName\": \"${fnskitBusinessType}\", \"group\": \"business\", \"validations\": {\"options\": {\"options\": [\"ip\", \"ooo\"]}}, \"annotations\": {\"inputType\": \"select\", \"inputOptionLabels\": {\"ip\": \"${fnskitBusinessType.ip}\", \"ooo\": \"${fnskitBusinessType.ooo}\"}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"company_name\", \"displayName\": \"${fnskitCompanyName}\", \"group\": \"business\", \"validations\": {\"length\": {\"max\": 200}}, \"annotations\": {\"inputHelperTextAfter\": \"${fnskitCompanyNameHelp}\"}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}, {\"name\": \"business\", \"displayHeader\": \"${fnskitBusinessHeader}\", \"displayDescription\": \"${fnskitBusinessDescription}\"}]}"
          ]
        }
      }
    ]
  },
  "localizationTexts": {
    "ru": {
      "fnskitBusinessHeader": "Бизнес",
      "fnskitBusinessDescription": "От формы бизнеса зависит набор документов в кабинете.",
